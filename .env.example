# Copie para .env.local e preencha com as chaves do projeto (Supabase > Project Settings > API).
# Sem estas variáveis o app roda em modo local: o progresso fica só no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada só no servidor, para criar as contas sem e-mail. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
